# Copy to `.env` and tweak. `docker compose` reads this file automatically.
# These are LOCAL DEV values - never reuse them in production.

# Port nginx is published on -> open http://localhost:8080
APP_PORT=8080

# PostgreSQL credentials + exposed port
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis exposed port (for redis-cli from your host)
REDIS_PORT=6379
